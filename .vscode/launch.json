{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome",
      "request": "launch",
      "type": "chrome",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome",
      "file": "${workspaceFolder}/lesson2/HTML_style.html",
      "webRoot": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally"
      },
       
      
    }
  ],
  "editor.inlineSuggest.enabled": false,
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "editor.suggest.showWords": true,
  "html.autocomplete.tags": true,
  "emmet.triggerExpansionOnTab": true,
  
}
